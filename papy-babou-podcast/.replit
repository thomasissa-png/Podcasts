run = "pip install -r requirements.txt && gunicorn -c gunicorn.conf.py web:app"
entrypoint = "web.py"
language = "python3"

[nix]
channel = "stable-23_11"

[env]
PYTHONPATH = "${REPL_HOME}/papy-babou-podcast"

[[ports]]
localPort = 5000
externalPort = 80

[objectStorage]
defaultBucketID = "replit-objstore-production"
# NOTE: Si Object Storage ne fonctionne pas, allez dans le panneau Replit :
# Tools > Object Storage > Create bucket
# Replit mettra a jour automatiquement le defaultBucketID ci-dessus.

[deployment]
run = ["sh", "-c", "pip install -r requirements.txt && gunicorn -c gunicorn.conf.py web:app"]
