# ── API Keys ─────────────────────────────────────────────────────────────────
# Ne jamais commiter le fichier .env avec les vraies valeurs !

# Anthropic (obligatoire) — Génération de scripts et métadonnées
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs (obligatoire en production) — TTS voix et bruitages SFX
ELEVENLABS_API_KEY=...

# Buzzsprout (optionnel) — Hébergement et distribution du podcast
BUZZSPROUT_API_KEY=...
BUZZSPROUT_PODCAST_ID=...

# Freesound (optionnel) — Fallback pour les bruitages SFX
# Obtenir une clé sur https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=...

# OpenAI (optionnel) — Génération de cover art via DALL-E 3
# Obtenir une clé sur https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Voice IDs ElevenLabs ────────────────────────────────────────────────────
# Créez des voix sur https://elevenlabs.io et copiez les IDs ici.
# Sans ces IDs, la production audio ne fonctionnera pas.
ELEVENLABS_VOICE_PAPY=...
ELEVENLABS_VOICE_ANTOINE=...
ELEVENLABS_VOICE_NOEMIE=...
ELEVENLABS_VOICE_NARRATEUR=...

# ── Configuration du podcast (optionnel) ────────────────────────────────────
# Ces valeurs peuvent aussi être modifiées directement dans config.py
# PODCAST_SITE_WEB=https://votre-site.com
# PODCAST_AUTEUR=Votre Nom
# PODCAST_EMAIL=contact@votre-site.com
