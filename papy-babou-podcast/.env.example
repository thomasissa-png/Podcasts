# API Keys — Ne jamais commiter le fichier .env avec les vraies valeurs
ANTHROPIC_API_KEY=sk-ant-...
ELEVENLABS_API_KEY=...
BUZZSPROUT_API_KEY=...
BUZZSPROUT_PODCAST_ID=...

# Freesound (optionnel — fallback pour les bruitages SFX)
# Obtenir une clé sur https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=...

